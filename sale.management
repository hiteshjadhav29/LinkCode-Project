from reportlab.pdfgen import canvas
import sqlite3

conn = sqlite3.connect("pharmacy.db")

cursor = conn.cursor()

cursor.execute("""
CREATE TABLE IF NOT EXISTS medicines(
    medicine_id INTEGER PRIMARY KEY AUTOINCREMENT,
    medicine_name TEXT,
    category TEXT,
    quantity INTEGER,
    price REAL,
    expiry_date TEXT
)
""")

conn.commit()

print("Database Connected Successfully")
print("Table Ready")


cart = []

def add_medicine():

    name = input("Enter Medicine Name : ")
    category = input("Enter Category : ")
    quantity = int(input("Enter Quantity : "))
    price = float(input("Enter Price : "))
    expiry = input("Enter Expiry Date (YYYY-MM-DD) : ")

    cursor.execute("""
    INSERT INTO medicines
    (medicine_name,category,quantity,price,expiry_date)
    VALUES(?,?,?,?,?)
    """,(name,category,quantity,price,expiry))

    conn.commit()

    print("Medicine Added Successfully")

def view_medicines():
    
    cursor.execute("SELECT * FROM medicines")

    data = cursor.fetchall()

    if len(data) == 0:
        print("No Medicines Found")

    else:
        print("\n-------------------------------------------------------------")
        print("ID\tName\tCategory\tQty\tPrice\tExpiry")
        print("-------------------------------------------------------------")

        for row in data:
            print(f"{row[0]}\t{row[1]}\t{row[2]}\t{row[3]}\t{row[4]}\t{row[5]}")

def search_medicine():
    
    mid = int(input("Enter Medicine ID : "))

    cursor.execute(
        "SELECT * FROM medicines WHERE medicine_id=?",
        (mid,)
    )

    data = cursor.fetchone()

    if data:

        print("\nMedicine Found")
        print("---------------------------")
        print("Medicine ID :", data[0])
        print("Medicine Name :", data[1])
        print("Category :", data[2])
        print("Quantity :", data[3])
        print("Price :", data[4])
        print("Expiry Date :", data[5])

    else:
        print("Medicine Not Found")

def update_medicine():
    
    mid = int(input("Enter Medicine ID : "))

    cursor.execute("SELECT * FROM medicines WHERE medicine_id=?",(mid,))
    data = cursor.fetchone()

    if data:

        quantity = int(input("Enter New Quantity : "))
        price = float(input("Enter New Price : "))

        cursor.execute(
            "UPDATE medicines SET quantity=?, price=? WHERE medicine_id=?",
            (quantity, price, mid)
        )

        conn.commit()

        print("Medicine Updated Successfully")

    else:

        print("Medicine Not Found")

def delete_medicine():
    
    mid = int(input("Enter Medicine ID : "))

    cursor.execute("SELECT * FROM medicines WHERE medicine_id=?",(mid,))
    data = cursor.fetchone()

    if data:

        cursor.execute(
            "DELETE FROM medicines WHERE medicine_id=?",
            (mid,)
        )

        conn.commit()

        print("Medicine Deleted Successfully")

    else:

        print("Medicine Not Found")

def add_to_cart():

    mid = int(input("Enter Medicine ID : "))
    qty = int(input("Enter Quantity : "))

    cursor.execute("SELECT * FROM medicines WHERE medicine_id=?",(mid,))
    data = cursor.fetchone()

    if data:

        if qty <= data[3]:

            total = qty * float(data[4])

            cart.append({
                "id": data[0],
                "name": data[1],
                "price": float(data[4]),
                "quantity": qty,
                "total": total
            })

            print("Product Added To Cart")

        else:

            print("Insufficient Stock")

    else:

        print("Medicine Not Found")

def remove_from_cart():
    
    mid = int(input("Enter Medicine ID To Remove : "))

    for item in cart:

        if item["id"] == mid:

            cart.remove(item)

            print("Product Removed Successfully")

            return

    print("Product Not Found In Cart")

def view_cart():
    
    if len(cart) == 0:

        print("Cart Is Empty")

    else:

        grand_total = 0

        print("\n---------------------------------------------------------")
        print("ID\tName\tQty\tPrice\tTotal")
        print("---------------------------------------------------------")

        for item in cart:

            print(item["id"],"\t",item["name"],"\t",item["quantity"],"\t",item["price"],"\t",item["total"])

            grand_total += item["total"]

        print("---------------------------------------------------------")
        print("Grand Total :", grand_total)

def clear_cart():
    cart.clear()
    print("Cart Cleared Successfully")

def generate_bill():
    
    if len(cart) == 0:

        print("Cart Is Empty")
        return

    customer = input("Enter Customer Name : ")

    grand_total = 0

    print("\n==========================================")
    print("        PHARMACY STORE BILL")
    print("==========================================")
    print("Customer :", customer)
    print("------------------------------------------")
    print("Medicine\tQty\tPrice\tTotal")

    for item in cart:

        print(item["name"],"\t",item["quantity"],"\t",item["price"],"\t",item["total"])

        grand_total += item["total"]

        cursor.execute(
            "UPDATE medicines SET quantity = quantity - ? WHERE medicine_id=?",
            (item["quantity"], item["id"])
        )

    conn.commit()

    gst = grand_total * 0.18
    final_amount = grand_total + gst

    print("------------------------------------------")
    print("Sub Total :", grand_total)
    print("GST (18%) :", gst)
    print("Final Amount :", final_amount)
    print("==========================================")

    cart.clear()

    print("Bill Generated Successfully")

def create_pdf():
    
    pdf = canvas.Canvas("Bill.pdf")

    pdf.setFont("Helvetica-Bold",18)
    pdf.drawString(180,800,"PHARMACY STORE BILL")

    pdf.setFont("Helvetica",12)

    pdf.drawString(50,760,"Thank You For Shopping!")

    pdf.drawString(50,730,"Generated Successfully")

    pdf.save()

    print("PDF Created Successfully")

while True:
    print("\n===== PHARMACY STORE MANAGEMENT =====")
    print("1. Add Medicine")
    print("2. View Medicines")
    print("3. Search Medicine")
    print("4. Update Medicine")
    print("5. Delete Medicine")
    print("6. Add To Cart")
    print("7. Remove From Cart")
    print("8. View Cart")
    print("9. Clear Cart")
    print("10. Generate Bill")
    print("11. Create PDF")
    print("12. Exit")

    choice = int(input("Enter Your Choice: "))

    if choice == 1:
        add_medicine()

    elif choice == 2:
        view_medicines()

    elif choice == 3:
        search_medicine()

    elif choice == 4:
        update_medicine()

    elif choice == 5:
        delete_medicine()

    elif choice == 6:
        add_to_cart()

    elif choice == 7:
        remove_from_cart()

    elif choice == 8:
        view_cart()

    elif choice == 9:
        clear_cart()

    elif choice == 10:
        generate_bill()

    elif choice == 11:
        create_pdf()

    elif choice == 12:
        print("Thank You!")
        break

    else:
        print("Invalid Choice!")

conn.close()
